        "distractors": [
          "sang were",
          "are singing"
        ],
        "explanation": "Tło: Past Continuous."
      },
      {
        "id": "b1-writing-story-3-03",
        "type": "choice",
        "prompt": "\"Help!\" she ___.",
        "answer": "shouted",
        "distractors": [
          "was shout",
          "shouting"
        ],
        "explanation": "Past Simple: shouted."
      },
      {
        "id": "b1-writing-story-3-04",
        "type": "cloze",
        "prompt": "I ran ___ fast as I could. (tak)",
        "answer": "as",
        "explanation": "As fast as I could."
      },
      {
        "id": "b1-writing-story-3-05",
        "type": "cloze",
        "prompt": "When we arrived, the film had already ___. (start)",
        "answer": "started",
        "explanation": "Past Perfect: had started."
      },
      {
        "id": "b1-writing-story-3-06",
        "type": "tiles",
        "prompt": "Ułóż opowiadanie.",
        "answer": [
          "Tom was late for the most important exam of his life.",
          "He ran to the bus stop, but the bus had just left.",
          "Just then, his neighbour stopped her car and offered him a lift.",
          "He arrived two minutes before the exam started."
        ],
        "distractors": [
          "To sum up, there are advantages and disadvantages."
        ],
        "explanation": "Problem, przeszkoda, zwrot akcji, rozwiązanie. Zdanie z rozprawki nie pasuje."
      },
      {
        "id": "b1-writing-story-3-07",
        "type": "error",
        "prompt": "When I arrived at the party, everyone has already left.",
        "answer": [
          "has",
          "had"
        ],
        "explanation": "Past Perfect: had left."
      },
      {
        "id": "b1-writing-story-3-08",
        "type": "translate",
        "prompt": "Byłem przerażony.",
        "answer": "I was terrified.",
        "accept": [
          "I was really scared.",
          "I was very scared.",
          "I was very frightened.",
          "I was really frightened."
        ],
        "explanation": "Mocny przymiotnik: terrified."
      },
      {
        "id": "b1-writing-story-3-09",
        "type": "transform",
        "prompt": "Zacznij od „Suddenly”.\nThe lights went out.",
        "answer": "Suddenly, the lights went out.",
        "accept": [
          "Suddenly the lights went out."
        ],
        "explanation": "Suddenly – zwrot akcji."
      },
      {
        "id": "b1-writing-story-3-10",
        "type": "choice",
        "prompt": "How can you make a story more interesting?",
        "answer": "add a short dialogue",
        "distractors": [
          "write only one paragraph",
          "use only \"nice\" and \"good\""
        ],
        "explanation": "Dialog ożywia tekst."
