        "distractors": [
          "like",
          "journal"
        ],
        "explanation": "Work as."
      },
      {
        "id": "b1-vocab-media-1-08",
        "type": "translate",
        "prompt": "Nie wierzę we wszystko, co czytam w internecie.",
