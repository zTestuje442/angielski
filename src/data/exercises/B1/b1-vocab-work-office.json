          "delayed off",
          "cancelled out"
        ],
        "explanation": "Przełożone: postponed."
      },
      {
        "id": "b1-vocab-work-office-1-04",
        "type": "cloze",
        "prompt": "Could you send me the ___ before the meeting? (porządek obrad)",
        "answer": "agenda",
        "explanation": "Porządek obrad: agenda."
      },
      {
        "id": "b1-vocab-work-office-1-05",
        "type": "cloze",
        "prompt": "We need to finish the report by Friday. That's the ___. (termin)",
        "answer": "deadline",
        "explanation": "Termin: deadline."
      },
      {
        "id": "b1-vocab-work-office-1-06",
        "type": "error",
        "prompt": "Please take notices during the meeting.",
        "answer": [
          "notices",
          "notes"
        ],
        "explanation": "Notatki: notes."
      },
      {
        "id": "b1-vocab-work-office-1-07",
        "type": "tiles",
        "prompt": "Czy możemy przełożyć spotkanie?",
        "answer": [
          "Can",
          "we",
          "reschedule",
          "the",
          "meeting"
        ],
        "distractors": [
          "do",
          "put"
        ],
        "explanation": "Przełożyć: reschedule."
      },
      {
        "id": "b1-vocab-work-office-1-08",
        "type": "translate",
        "prompt": "Jestem na spotkaniu.",
        "answer": "I am in a meeting.",
        "accept": [
          "I am at a meeting."
        ],
        "explanation": "Być na spotkaniu: be in a meeting."
      },
      {
        "id": "b1-vocab-work-office-1-09",
        "type": "transform",
        "prompt": "Zamień na grzeczną prośbę z „Could you”.\nSend me the file.",
        "answer": "Could you send me the file, please?",
        "accept": [
          "Could you send me the file?",
          "Could you please send me the file?",
          "Could you send me the file please?"
        ],
        "explanation": "Could you..., please?"
      },
      {
        "id": "b1-vocab-work-office-1-10",
        "type": "choice",
        "prompt": "I'm afraid Mr Smith is ___ at the moment. Can I take a message?",
        "answer": "not available",
        "distractors": [
          "not enable",
          "unable"
        ],
        "explanation": "Niedostępny: not available."
      }
    ]
  },
