    "exercises": [
      {
        "id": "b1-vocab-work-office-1-01",
        "type": "match",
        "prompt": "Połącz słowa z tłumaczeniem.",
        "answer": [
          "agenda|porządek spotkania",
          "deadline|termin",
          "minutes|protokół ze spotkania",
          "colleague|współpracownik"
        ],
        "explanation": "Słowa ze spotkań."
      },
      {
        "id": "b1-vocab-work-office-1-02",
        "type": "choice",
        "prompt": "Let's ___ a meeting for Monday.",
        "answer": "arrange",
        "distractors": [
          "make up",
          "do"
        ],
        "explanation": "Umówić spotkanie: arrange a meeting."
      },
      {
        "id": "b1-vocab-work-office-1-03",
        "type": "choice",
        "prompt": "The meeting has been ___ until next week.",
        "answer": "postponed",
