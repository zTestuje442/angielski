          "reproduce"
        ],
        "explanation": "Czasownik: reproduce."
      },
      {
        "id": "b2-vocab-it-software-testing-3-07",
        "type": "error",
        "prompt": "I made a ticket to the support team.",
        "answer": [
          "made",
          "raised"
        ],
        "explanation": "Zgłosić zgłoszenie: raise a ticket."
      },
      {
        "id": "b2-vocab-it-software-testing-3-08",
        "type": "tiles",
        "prompt": "Wynik oczekiwany różni się od rzeczywistego.",
        "answer": [
          "The",
          "expected",
          "result",
          "is",
          "different",
          "from",
          "the",
          "actual",
          "result"
        ],
        "distractors": [
          "of",
          "current"
        ],
        "explanation": "Expected / actual."
      },
      {
        "id": "b2-vocab-it-software-testing-3-09",
        "type": "translate",
        "prompt": "Kiedy jest następne wydanie?",
        "answer": "When is the next release?",
        "accept": [
          "When's the next release?"
        ],
        "explanation": "Release."
      },
      {
        "id": "b2-vocab-it-software-testing-3-10",
        "type": "transform",
        "prompt": "Zamień na stronę bierną, zacznij od „The new version”.\nWe will release the new version next week.",
