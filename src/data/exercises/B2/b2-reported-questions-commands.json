[
  {
    "id": "b2-reported-questions-commands-1",
    "topicId": "b2-reported-questions-commands",
    "exercises": [
      {
        "id": "b2-reported-questions-commands-1-01",
        "type": "cloze",
        "prompt": "\"Where do you live?\" → She asked me where I ___.",
        "meaning": "„Gdzie mieszkasz?” → Zapytała mnie, gdzie mieszkam.",
        "answer": "lived",
        "explanation": "Szyk twierdzący, czas cofnięty."
      },
      {
        "id": "b2-reported-questions-commands-1-02",
        "type": "cloze",
        "prompt": "\"Are you tired?\" → He asked me ___ I was tired.",
        "meaning": "„Jesteś zmęczony?” → Zapytał mnie, czy jestem zmęczony.",
        "answer": "if",
        "accept": [
          "whether"
        ],
        "explanation": "Pytanie tak/nie: if / whether."
      },
      {
        "id": "b2-reported-questions-commands-1-03",
        "type": "choice",
        "prompt": "\"What time is it?\" → She asked what time ___.",
        "answer": "it was",
        "distractors": [
          "was it",
          "is it"
        ],
        "explanation": "Szyk twierdzący: it was."
      },
      {
        "id": "b2-reported-questions-commands-1-04",
        "type": "choice",
        "prompt": "\"Close the door.\" → He told me ___ the door.",
        "answer": "to close",
        "distractors": [
          "close",
          "closing"
        ],
        "explanation": "Tell + osoba + to."
      },
      {
        "id": "b2-reported-questions-commands-1-05",
        "type": "cloze",
        "prompt": "\"Don't be late.\" → She told us ___ to be late.",
        "meaning": "„Nie spóźnijcie się.” → Powiedziała nam, żebyśmy się nie spóźnili.",
        "answer": "not",
        "explanation": "Zakaz: not to."
      },
      {
        "id": "b2-reported-questions-commands-1-06",
        "type": "match",
        "prompt": "Połącz wypowiedź z jej relacją.",
        "answer": [
          "\"Can you help?\"|She asked if I could help.",
          "\"Sit down.\"|He told me to sit down.",
          "\"Don't shout.\"|She told me not to shout.",
          "\"Where is he?\"|They asked where he was."
        ],
        "explanation": "Pytania i polecenia w mowie zależnej."
      },
      {
        "id": "b2-reported-questions-commands-1-07",
        "type": "error",
        "prompt": "He asked me if I am hungry.",
        "answer": [
          "am",
          "was"
        ],
        "explanation": "Czas cofnięty: was."
      },
      {
        "id": "b2-reported-questions-commands-1-08",
        "type": "tiles",
        "prompt": "Zapytał mnie, ile mam lat.",
        "answer": [
          "He",
          "asked",
          "me",
          "how",
          "old",
          "I",
          "was"
        ],
        "distractors": [
          "am",
          "did"
        ],
        "explanation": "Szyk twierdzący: how old I was."
      },
      {
        "id": "b2-reported-questions-commands-1-09",
        "type": "translate",
        "prompt": "Kazała mi poczekać.",
        "answer": "She told me to wait.",
        "explanation": "Tell + osoba + to."
      },
      {
        "id": "b2-reported-questions-commands-1-10",
        "type": "transform",
        "prompt": "Zamień na mowę zależną, zacznij od „She asked me”.\n\"Do you like jazz?\"",
        "answer": "She asked me if I liked jazz.",
        "accept": [
          "She asked me whether I liked jazz."
        ],
        "explanation": "If + szyk twierdzący."
      }
    ]
  },
  {
