          "some",
          "extent",
          "I",
          "agree",
          "with",
          "you"
        ],
        "distractors": [
          "extend",
          "on"
        ],
        "explanation": "To some extent."
      },
      {
        "id": "c1-vocab-hedging-2-08",
        "type": "translate",
        "prompt": "Podobno zamykają fabrykę.",
        "answer": "Apparently, they are closing the factory.",
        "accept": [
          "Apparently they are closing the factory.",
          "Apparently, the factory is closing.",
          "Apparently the factory is closing.",
          "They are apparently closing the factory."
        ],
        "explanation": "Apparently."
      },
      {
        "id": "c1-vocab-hedging-2-09",
        "type": "transform",
        "prompt": "Złagodź twierdzenie, użyj „appear”.\nThe new system is more efficient.",
        "answer": "The new system appears to be more efficient.",
        "accept": [
          "It appears that the new system is more efficient."
        ],
        "explanation": "Appear to be."
      },
      {
        "id": "c1-vocab-hedging-2-10",
        "type": "choice",
        "prompt": "Which word is NOT used for hedging?",
        "answer": "definitely",
        "distractors": [
          "possibly",
          "presumably"
        ],
        "explanation": "Definitely jest kategoryczne."
      }
    ]
  },
