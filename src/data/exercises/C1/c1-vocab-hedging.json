[
  {
    "id": "c1-vocab-hedging-1",
    "topicId": "c1-vocab-hedging",
    "exercises": [
      {
        "id": "c1-vocab-hedging-1-01",
        "type": "match",
        "prompt": "Połącz wyrażenia z tłumaczeniem.",
        "answer": [
          "arguably|prawdopodobnie, można argumentować",
          "apparently|podobno",
          "presumably|przypuszczalnie",
          "to some extent|do pewnego stopnia"
        ],
        "explanation": "Hedging."
      },
      {
        "id": "c1-vocab-hedging-1-02",
        "type": "choice",
        "prompt": "Which sentence is hedged?",
        "answer": "The results suggest that the drug may be effective.",
        "distractors": [
          "The drug works.",
          "The drug is 100% effective."
        ],
        "explanation": "Ostrożnie: suggest, may."
      },
      {
        "id": "c1-vocab-hedging-1-03",
        "type": "choice",
        "prompt": "People ___ to buy more when they are hungry.",
        "answer": "tend",
        "distractors": [
          "seem it",
          "appear it"
        ],
        "explanation": "Tend to."
      },
      {
        "id": "c1-vocab-hedging-1-04",
        "type": "cloze",
        "prompt": "It ___ that the problem has been solved. (wydaje się)",
        "answer": "appears",
        "accept": [
          "seems"
        ],
        "explanation": "It appears that..."
      },
      {
        "id": "c1-vocab-hedging-1-05",
        "type": "cloze",
        "prompt": "It could be ___ that the policy has failed. (można by argumentować)",
        "answer": "argued",
        "explanation": "It could be argued that..."
      },
      {
        "id": "c1-vocab-hedging-1-06",
        "type": "error",
        "prompt": "The data clearly prove that the theory might be correct.",
        "answer": [
          "prove",
          "suggest"
        ],
        "explanation": "Hedging: suggest zamiast prove (zgodnie z „might”)."
      },
      {
        "id": "c1-vocab-hedging-1-07",
        "type": "tiles",
        "prompt": "To jest prawdopodobnie najlepsze rozwiązanie.",
        "answer": [
          "This",
          "is",
          "arguably",
          "the",
          "best",
          "solution"
        ],
        "distractors": [
          "argue",
          "arguable"
        ],
        "explanation": "Arguably."
      },
      {
        "id": "c1-vocab-hedging-1-08",
        "type": "translate",
        "prompt": "Wydaje się, że ceny rosną.",
        "answer": "It seems that prices are rising.",
        "accept": [
          "It appears that prices are rising.",
          "Prices seem to be rising.",
          "Prices appear to be rising.",
          "It seems prices are rising."
        ],
        "explanation": "It seems that..."
      },
      {
        "id": "c1-vocab-hedging-1-09",
        "type": "choice",
        "prompt": "Which phrase means \"do pewnego stopnia\"?",
        "answer": "to a certain degree",
        "distractors": [
          "by all means",
          "at any rate"
        ],
        "explanation": "To a certain degree."
      },
      {
        "id": "c1-vocab-hedging-1-10",
        "type": "transform",
        "prompt": "Złagodź twierdzenie, użyj „may”.\nThis causes the problem.",
        "answer": "This may cause the problem.",
        "explanation": "May – ostrożność."
      }
    ]
  },
