          "did",
          "so"
        ],
        "distractors": [
          "made",
          "it's"
        ],
        "explanation": "Do so."
      },
      {
        "id": "c1-sent-cohesion-reference-2-08",
        "type": "translate",
        "prompt": "Ta decyzja wywołała protesty.",
        "answer": "This decision sparked protests.",
        "accept": [
