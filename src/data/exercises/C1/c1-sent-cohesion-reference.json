          "That decision caused protests.",
          "This decision led to protests.",
          "The decision sparked protests.",
          "The decision caused protests."
        ],
        "explanation": "This decision + spark."
      },
      {
        "id": "c1-sent-cohesion-reference-2-09",
        "type": "choice",
        "prompt": "Which word replaces a whole previous idea?",
        "answer": "this",
        "distractors": [
          "one",
          "ones"
        ],
        "explanation": "This."
      },
      {
        "id": "c1-sent-cohesion-reference-2-10",
        "type": "transform",
        "prompt": "Zastąp powtórzenie wyrażeniem „do so”.\nShe promised to call, and she called.",
        "answer": "She promised to call, and she did so.",
        "accept": [
          "She promised to call and she did so."
        ],
        "explanation": "Do so."
      }
