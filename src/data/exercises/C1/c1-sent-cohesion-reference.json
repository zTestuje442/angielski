[
  {
    "id": "c1-sent-cohesion-reference-1",
    "topicId": "c1-sent-cohesion-reference",
    "exercises": [
      {
        "id": "c1-sent-cohesion-reference-1-01",
        "type": "match",
        "prompt": "Połącz wyrażenia z tłumaczeniem.",
        "answer": [
          "the former|pierwszy z wymienionych",
          "the latter|drugi z wymienionych",
          "such measures|takie środki",
          "do so|zrobić to"
        ],
        "explanation": "Odwołania w tekście."
      },
      {
        "id": "c1-sent-cohesion-reference-1-02",
        "type": "cloze",
        "prompt": "The government raised taxes. ___ decision was very unpopular. (ta)",
        "answer": "This",
        "accept": [
          "That",
          "The"
        ],
        "explanation": "This + rzeczownik podsumowujący."
      },
      {
        "id": "c1-sent-cohesion-reference-1-03",
        "type": "cloze",
        "prompt": "Many wanted to protest, but few actually did ___.",
        "meaning": "Wielu chciało protestować, ale niewielu to zrobiło.",
        "answer": "so",
        "explanation": "Do so."
      },
      {
        "id": "c1-sent-cohesion-reference-1-04",
        "type": "choice",
        "prompt": "I like both tea and coffee, but I prefer the ___.",
        "answer": "latter",
        "distractors": [
          "later",
          "last one of"
        ],
        "explanation": "The latter – drugie z wymienionych."
      },
      {
        "id": "c1-sent-cohesion-reference-1-05",
        "type": "choice",
        "prompt": "Smartphones are everywhere. ___ devices have changed how we communicate.",
        "answer": "These",
        "distractors": [
          "This",
          "Those ones"
        ],
        "explanation": "These + l. mn."
      },
      {
        "id": "c1-sent-cohesion-reference-1-06",
        "type": "error",
        "prompt": "Some students passed the exam; other didn't.",
        "answer": [
          "other",
          "others"
        ],
        "explanation": "Samodzielnie: others."
      },
      {
        "id": "c1-sent-cohesion-reference-1-07",
        "type": "tiles",
        "prompt": "Takie środki rzadko są popularne.",
        "answer": [
          "Such",
          "measures",
          "are",
          "rarely",
          "popular"
        ],
        "distractors": [
          "So",
          "measure"
        ],
        "explanation": "Such + rzeczownik."
      },
      {
        "id": "c1-sent-cohesion-reference-1-08",
        "type": "translate",
        "prompt": "To sugeruje, że problem jest poważny.",
        "answer": "This suggests that the problem is serious.",
        "accept": [
          "This suggests the problem is serious.",
          "That suggests that the problem is serious."
        ],
        "explanation": "This o całej myśli."
      },
      {
        "id": "c1-sent-cohesion-reference-1-09",
        "type": "choice",
        "prompt": "Which sentence has an unclear reference?",
        "answer": "Anna told Kate that she was wrong.",
        "distractors": [
          "Anna told Kate that Kate was wrong.",
          "Anna admitted that she herself was wrong."
        ],
        "explanation": "She – Anna czy Kate?"
      },
      {
        "id": "c1-sent-cohesion-reference-1-10",
        "type": "transform",
        "prompt": "Zastąp powtórzenie słowem „ones”.\nI don't want these shoes. I want the black shoes.",
        "answer": "I don't want these shoes. I want the black ones.",
        "explanation": "Ones zamiast l. mn."
      }
    ]
  },
  {
