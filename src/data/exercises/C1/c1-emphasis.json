[
  {
    "id": "c1-emphasis-1",
    "topicId": "c1-emphasis",
    "exercises": [
      {
        "id": "c1-emphasis-1-01",
        "type": "cloze",
        "prompt": "I ___ like your new haircut! It really suits you.",
        "meaning": "Naprawdę podoba mi się twoja nowa fryzura! Świetnie ci w niej.",
        "answer": "do",
        "explanation": "Emfaza: do + czasownik."
      },
      {
        "id": "c1-emphasis-1-02",
        "type": "cloze",
        "prompt": "This is the ___ thing I needed!",
        "meaning": "To jest dokładnie to, czego potrzebowałem!",
        "answer": "very",
        "explanation": "The very – właśnie ten."
      },
      {
        "id": "c1-emphasis-1-03",
        "type": "choice",
        "prompt": "It was ___ a boring lecture that I fell asleep.",
        "answer": "such",
        "distractors": [
          "so",
          "very"
        ],
        "explanation": "Such a + przymiotnik + rzeczownik."
      },
      {
        "id": "c1-emphasis-1-04",
        "type": "choice",
        "prompt": "What ___ earth are you doing?",
        "answer": "on",
        "distractors": [
          "in",
          "at"
        ],
        "explanation": "What on earth...?"
      },
      {
        "id": "c1-emphasis-1-05",
        "type": "choice",
        "prompt": "She is ___ the best student in the class.",
        "answer": "by far",
        "distractors": [
          "very",
          "too far"
        ],
        "explanation": "By far + stopień najwyższy."
      },
      {
        "id": "c1-emphasis-1-06",
        "type": "match",
        "prompt": "Połącz wyrażenia z tłumaczeniem.",
        "answer": [
          "I did tell you!|Przecież ci mówiłem!",
          "the very beginning|sam początek",
          "no idea whatsoever|zupełnie żadnego pojęcia",
          "by far the best|zdecydowanie najlepszy"
        ],
        "explanation": "Wzmocnienia."
      },
      {
        "id": "c1-emphasis-1-07",
        "type": "error",
        "prompt": "I was very exhausted after the marathon.",
        "answer": [
          "very",
          "absolutely"
        ],
        "explanation": "Mocny przymiotnik: absolutely exhausted."
      },
      {
        "id": "c1-emphasis-1-08",
        "type": "tiles",
        "prompt": "Przecież ci mówiłem!",
        "answer": [
          "I",
          "did",
          "tell",
          "you"
        ],
        "distractors": [
          "telling",
          "was"
        ],
        "explanation": "Did + czasownik."
      },
      {
        "id": "c1-emphasis-1-09",
        "type": "translate",
        "prompt": "Nie mam zupełnie żadnego pojęcia.",
        "answer": "I have no idea whatsoever.",
        "accept": [
          "I have absolutely no idea.",
          "I have no idea at all.",
          "I've no idea whatsoever."
        ],
        "explanation": "Whatsoever po przeczeniu."
      },
      {
        "id": "c1-emphasis-1-10",
        "type": "transform",
        "prompt": "Dodaj emfazę z „does”.\nShe knows a lot about history.",
        "answer": "She does know a lot about history.",
        "explanation": "Does + forma podstawowa."
      }
    ]
  },
  {
