        "prompt": "Ta sukienka jest dużo tańsza.",
        "answer": [
          "This",
          "dress",
          "is",
          "much",
          "cheaper"
        ],
        "explanation": "Much + stopień wyższy."
      },
      {
        "id": "a2-sent-comparisons-2-08",
        "type": "translate",
        "prompt": "Jestem tak samo zmęczony jak ty.",
        "answer": "I am as tired as you.",
        "accept": [
          "I'm as tired as you.",
          "I am as tired as you are.",
          "I'm as tired as you are."
        ],
        "explanation": "As ... as."
      },
      {
        "id": "a2-sent-comparisons-2-09",
        "type": "choice",
        "prompt": "Which word goes with a superlative?",
        "answer": "the",
        "distractors": [
          "than",
          "as"
        ],
        "explanation": "The + stopień najwyższy."
      },
      {
        "id": "a2-sent-comparisons-2-10",
        "type": "transform",
        "prompt": "Napisz zdanie ze stopniem najwyższym, zacznij od „It's the”.\nThis film is very funny – funnier than all others.",
        "answer": "It's the funniest film.",
        "accept": [
          "It is the funniest film.",
          "It's the funniest film of all.",
          "It is the funniest film of all."
        ],
        "explanation": "Funny → the funniest."
      }
    ]
  },
