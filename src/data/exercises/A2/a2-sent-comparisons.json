[
  {
    "id": "a2-sent-comparisons-1",
    "topicId": "a2-sent-comparisons",
    "exercises": [
      {
        "id": "a2-sent-comparisons-1-01",
        "type": "match",
        "prompt": "Połącz wyrażenia z tłumaczeniem.",
        "answer": [
          "bigger than|większy niż",
          "the biggest|największy",
          "as big as|tak duży jak",
          "not as big as|nie tak duży jak"
        ],
        "explanation": "Porównania."
      },
      {
        "id": "a2-sent-comparisons-1-02",
        "type": "cloze",
        "prompt": "My sister is older ___ me.",
        "meaning": "Moja siostra jest starsza ode mnie.",
        "answer": "than",
        "explanation": "Stopień wyższy + than."
      },
      {
        "id": "a2-sent-comparisons-1-03",
        "type": "cloze",
        "prompt": "This is the ___ day of the year. (najgorętszy – hot)",
        "answer": "hottest",
        "explanation": "Hot → the hottest."
      },
      {
        "id": "a2-sent-comparisons-1-04",
        "type": "choice",
        "prompt": "Planes are ___ than trains.",
        "answer": "faster",
        "distractors": [
          "more fast",
          "fastest"
        ],
        "explanation": "Fast → faster."
      },
      {
        "id": "a2-sent-comparisons-1-05",
        "type": "choice",
        "prompt": "She is ___ tall as her father.",
        "answer": "as",
        "distractors": [
          "so",
          "than"
        ],
        "explanation": "As ... as."
      },
      {
        "id": "a2-sent-comparisons-1-06",
        "type": "error",
        "prompt": "This book is more better than the film.",
        "answer": [
          "more",
          "much"
        ],
        "explanation": "Better bez more; wzmocnienie: much better."
      },
      {
        "id": "a2-sent-comparisons-1-07",
        "type": "tiles",
        "prompt": "Mój pokój jest większy niż twój.",
        "answer": [
          "My",
          "room",
          "is",
          "bigger",
          "than",
          "yours"
        ],
        "explanation": "Bigger than."
      },
      {
        "id": "a2-sent-comparisons-1-08",
        "type": "translate",
        "prompt": "To najlepsza restauracja w mieście.",
        "answer": "This is the best restaurant in town.",
        "accept": [
          "It is the best restaurant in town.",
          "This is the best restaurant in the city.",
          "It is the best restaurant in the city.",
          "It's the best restaurant in town."
        ],
        "explanation": "The best + in."
      },
      {
        "id": "a2-sent-comparisons-1-09",
        "type": "choice",
        "prompt": "Which sentence is correct?",
        "answer": "Tom is taller than me.",
        "distractors": [
          "Tom is more tall than me.",
          "Tom is taller that me."
        ],
        "explanation": "Taller than."
      },
      {
        "id": "a2-sent-comparisons-1-10",
        "type": "transform",
        "prompt": "Użyj „not as ... as”, zacznij od „Gdańsk isn't”.\nWarsaw is bigger than Gdańsk.",
        "answer": "Gdańsk isn't as big as Warsaw.",
        "accept": [
          "Gdańsk is not as big as Warsaw."
        ],
        "explanation": "Not as ... as."
      }
    ]
  },
  {
    "id": "a2-sent-comparisons-2",
    "topicId": "a2-sent-comparisons",
    "exercises": [
      {
