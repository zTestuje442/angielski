[
  {
    "id": "a2-comparatives-superlatives-1",
    "topicId": "a2-comparatives-superlatives",
    "exercises": [
      {
        "id": "a2-comparatives-superlatives-1-01",
        "type": "cloze",
        "prompt": "My brother is ___ than me. (tall)",
        "answer": "taller",
        "explanation": "Krótki przymiotnik: -er."
      },
      {
        "id": "a2-comparatives-superlatives-1-02",
        "type": "cloze",
        "prompt": "This bag is ___ than that one. (heavy)",
        "answer": "heavier",
        "explanation": "-y → -ier."
      },
      {
        "id": "a2-comparatives-superlatives-1-03",
        "type": "cloze",
        "prompt": "A car is ___ than a bike. (expensive)",
        "answer": "more expensive",
        "explanation": "Długi przymiotnik: more."
      },
      {
        "id": "a2-comparatives-superlatives-1-04",
        "type": "choice",
        "prompt": "London is ___ than Oxford.",
        "answer": "bigger",
        "distractors": [
          "more big",
          "biger"
        ],
        "explanation": "Big → bigger (podwojenie g)."
      },
      {
        "id": "a2-comparatives-superlatives-1-05",
        "type": "choice",
        "prompt": "Today is ___ than yesterday.",
        "answer": "better",
        "distractors": [
          "gooder",
          "more good"
        ],
        "explanation": "Good → better."
      },
      {
        "id": "a2-comparatives-superlatives-1-06",
        "type": "match",
        "prompt": "Połącz przymiotnik ze stopniem wyższym.",
        "answer": [
          "big|bigger",
          "happy|happier",
          "good|better",
          "bad|worse"
        ],
        "explanation": "Stopień wyższy: -er, -ier i nieregularne."
      },
      {
        "id": "a2-comparatives-superlatives-1-07",
        "type": "error",
        "prompt": "Spain is hoter than Poland in summer.",
        "answer": [
          "hoter",
          "hotter"
        ],
        "explanation": "Hot → hotter (podwojenie t)."
      },
      {
        "id": "a2-comparatives-superlatives-1-08",
        "type": "tiles",
        "prompt": "Kot jest mniejszy niż pies.",
        "answer": [
          "The",
          "cat",
          "is",
          "smaller",
          "than",
          "the",
          "dog"
        ],
        "explanation": "Small → smaller + than."
      },
      {
        "id": "a2-comparatives-superlatives-1-09",
        "type": "translate",
        "prompt": "Moje mieszkanie jest tańsze niż twoje.",
        "answer": "My flat is cheaper than yours.",
        "accept": [
          "My flat is cheaper than your flat.",
          "My apartment is cheaper than yours."
        ],
        "explanation": "Cheap → cheaper."
      },
      {
        "id": "a2-comparatives-superlatives-1-10",
        "type": "transform",
        "prompt": "Porównaj, używając „old” i „than”.\nTom is 20. Ann is 25.",
        "answer": "Ann is older than Tom.",
        "accept": [
          "Tom is younger than Ann."
        ],
        "explanation": "Old → older + than."
      }
    ]
  },
