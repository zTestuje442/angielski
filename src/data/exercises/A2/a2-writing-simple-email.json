    "exercises": [
      {
        "id": "a2-writing-simple-email-1-01",
        "type": "match",
        "prompt": "Połącz zwroty z ich funkcją.",
        "answer": [
          "Hi Anna,|powitanie",
          "How are you?|zagajenie",
          "Write soon!|prośba o odpowiedź",
          "Best wishes,|pozdrowienia przed podpisem"
        ],
        "explanation": "Elementy e-maila."
      },
      {
        "id": "a2-writing-simple-email-1-02",
        "type": "choice",
        "prompt": "Which is the best first sentence after \"Hi Mark,\" in an email to a friend?",
        "answer": "Thanks for your email.",
        "distractors": [
          "Yours faithfully.",
          "I am writing to complain about your service."
        ],
        "explanation": "Do znajomego: podziękowanie za e-mail."
      },
      {
        "id": "a2-writing-simple-email-1-03",
        "type": "choice",
        "prompt": "Which ending is good for an email to a friend?",
        "answer": "Write soon,",
        "distractors": [
          "Yours sincerely,",
          "Regards from the management,"
        ],
        "explanation": "Nieformalnie: Write soon, Love, Best wishes."
      },
      {
        "id": "a2-writing-simple-email-1-04",
        "type": "cloze",
        "prompt": "Thanks ___ your email. (za)",
        "answer": "for",
        "explanation": "Thanks for..."
      },
      {
        "id": "a2-writing-simple-email-1-05",
        "type": "cloze",
        "prompt": "It was great to ___ from you. (usłyszeć)",
        "answer": "hear",
        "explanation": "Hear from = mieć wiadomość od."
      },
      {
        "id": "a2-writing-simple-email-1-06",
        "type": "cloze",
        "prompt": "I'm ___ to tell you about my new job. (piszę)",
        "answer": "writing",
        "explanation": "Piszę, żeby...: I'm writing to..."
      },
      {
        "id": "a2-writing-simple-email-1-07",
        "type": "tiles",
        "prompt": "E-mail od Ewy do Sama.",
        "answer": [
          "Hi Sam,",
          "Thanks for your email. It was great to hear from you.",
          "I have some news: I've got a new job in a hotel!",
          "I start on Monday and I'm a bit nervous.",
          "Write soon,",
          "Ewa"
        ],
        "explanation": "Powitanie, wstęp, nowina, szczegóły, zakończenie, podpis."
      },
      {
        "id": "a2-writing-simple-email-1-08",
        "type": "error",
        "prompt": "Thank you for you email.",
        "answer": [
          "you",
          "your"
        ],
        "explanation": "Twój e-mail: your email."
      },
      {
        "id": "a2-writing-simple-email-1-09",
        "type": "translate",
        "prompt": "Jak się masz?",
        "answer": "How are you?",
        "accept": [
          "How are you doing?"
        ],
        "explanation": "Zagajenie: How are you?"
      },
      {
        "id": "a2-writing-simple-email-1-10",
        "type": "transform",
        "prompt": "Połącz zdania słowem „and”.\nThe hotel is big. It is near the beach.",
        "answer": "The hotel is big and it is near the beach.",
        "accept": [
          "The hotel is big and near the beach.",
          "The hotel is big, and it is near the beach."
        ],
        "explanation": "Dodanie: and."
      }
    ]
  },
  {
