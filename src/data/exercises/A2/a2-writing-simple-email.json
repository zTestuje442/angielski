        "accept": [
          "The hotel is nice but the food is terrible."
        ],
        "explanation": "Przeciwieństwo: but."
      },
      {
        "id": "a2-writing-simple-email-2-10",
        "type": "translate",
        "prompt": "Pogoda jest piękna.",
        "answer": "The weather is beautiful.",
        "accept": [
          "The weather is lovely.",
          "The weather is nice.",
          "The weather is great."
        ],
        "explanation": "Pogoda: the weather."
      }
    ]
  },
