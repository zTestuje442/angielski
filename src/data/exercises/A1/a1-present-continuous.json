      {
        "id": "a1-present-continuous-1-01",
        "type": "cloze",
        "prompt": "I ___ reading a book now.",
        "meaning": "Teraz czytam książkę.",
        "answer": "am",
        "explanation": "I + am + -ing."
      },
      {
        "id": "a1-present-continuous-1-02",
        "type": "cloze",
        "prompt": "She is ___ a letter. (write)",
        "answer": "writing",
        "explanation": "Write → writing (znika -e)."
      },
      {
        "id": "a1-present-continuous-1-03",
        "type": "cloze",
        "prompt": "They are ___ in the pool. (swim)",
        "answer": "swimming",
        "explanation": "Swim → swimming (podwójne m)."
      },
      {
        "id": "a1-present-continuous-1-04",
        "type": "choice",
        "prompt": "Look! It ___.",
        "answer": "is raining",
        "distractors": [
          "rains",
          "raining"
        ],
        "explanation": "Look! – dzieje się teraz: is raining."
      },
      {
        "id": "a1-present-continuous-1-05",
        "type": "choice",
        "prompt": "We ___ dinner at the moment.",
        "answer": "are having",
        "distractors": [
          "have",
          "is having"
        ],
        "explanation": "At the moment + we are + -ing."
      },
      {
        "id": "a1-present-continuous-1-06",
        "type": "match",
        "prompt": "Połącz czasownik z formą -ing.",
        "answer": [
          "make|making",
          "run|running",
          "sit|sitting",
          "play|playing"
        ],
        "explanation": "Make – znika -e; run, sit – podwójna spółgłoska; play – samo -ing."
      },
      {
        "id": "a1-present-continuous-1-07",
        "type": "tiles",
        "prompt": "Ona teraz śpi.",
        "answer": [
          "She",
          "is",
          "sleeping",
          "now"
        ],
        "explanation": "She is + sleeping."
      },
      {
        "id": "a1-present-continuous-1-08",
        "type": "error",
        "prompt": "He is watch TV.",
        "answer": [
          "watch",
          "watching"
        ],
        "explanation": "Po is potrzebna forma -ing."
      },
      {
        "id": "a1-present-continuous-1-09",
        "type": "translate",
        "prompt": "Czekam na autobus.",
        "answer": "I am waiting for the bus.",
        "accept": [
          "I am waiting for a bus."
        ],
        "explanation": "Teraz, w tej chwili: I am waiting."
      },
      {
        "id": "a1-present-continuous-1-10",
        "type": "transform",
        "prompt": "Opisz, co dzieje się teraz.\nI read a book.",
        "answer": "I am reading a book.",
        "explanation": "Teraz: am + reading."
      }
    ]
  },
