[
  {
    "id": "a1-vocab-adjectives-opposites-1",
    "topicId": "a1-vocab-adjectives-opposites",
    "exercises": [
      {
        "id": "a1-vocab-adjectives-opposites-1-01",
        "type": "match",
        "prompt": "Połącz przymiotniki z przeciwieństwami.",
        "answer": [
          "big|small",
          "hot|cold",
          "fast|slow",
          "cheap|expensive"
        ],
        "explanation": "Przeciwieństwa."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-02",
        "type": "cloze",
        "prompt": "This test is not difficult. It's ___. (łatwy)",
        "answer": "easy",
        "explanation": "Easy – difficult."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-03",
        "type": "cloze",
        "prompt": "My grandma is old, but my sister is ___. (młoda)",
        "answer": "young",
        "explanation": "Old – young (ludzie)."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-04",
        "type": "choice",
        "prompt": "A Ferrari is a very ___ car.",
        "answer": "fast",
        "distractors": [
          "slow",
          "short"
        ],
        "explanation": "Szybki: fast."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-05",
        "type": "choice",
        "prompt": "They are ___ houses.",
        "answer": "big",
        "distractors": [
          "bigs",
          "biggs"
        ],
        "explanation": "Przymiotnik bez liczby mnogiej."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-06",
        "type": "error",
        "prompt": "I have two news phones.",
        "answer": [
          "news",
          "new"
        ],
        "explanation": "Przymiotnik bez -s."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-07",
        "type": "tiles",
        "prompt": "Ta kawa jest zimna.",
        "answer": [
          "This",
          "coffee",
          "is",
          "cold"
        ],
        "explanation": "Be + przymiotnik."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-08",
        "type": "translate",
        "prompt": "To jest drogi samochód.",
        "answer": "This is an expensive car.",
        "accept": [
          "It is an expensive car.",
          "It's an expensive car.",
          "That is an expensive car."
        ],
        "explanation": "An przed samogłoską."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-09",
        "type": "choice",
        "prompt": "The opposite of \"tall\" (about people) is:",
        "answer": "short",
        "distractors": [
          "small",
          "little"
        ],
        "explanation": "Tall – short."
      },
      {
        "id": "a1-vocab-adjectives-opposites-1-10",
        "type": "transform",
        "prompt": "Zmień przymiotnik na przeciwny.\nThe room is clean.",
        "answer": "The room is dirty.",
        "explanation": "Clean – dirty."
      }
    ]
  },
